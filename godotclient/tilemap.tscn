[sub_resource type="GDScript" id="GDScript_5f3km"]
script/source = "extends TileMap

var last_game_size = Vector2(1,1)

# Called when the node enters the scene tree for the first time.
func _ready():
	Globals.sub(self, \"game_state\")
	Globals.sub(self, \"connected\")

func _draw():
	var line_color = Color.WHEAT.lerp(Color.TRANSPARENT, 0.8)
	for i in range(0,last_game_size.x+1):
		draw_line(Vector2(16*i,0), Vector2(16*i,16*last_game_size.y), line_color, 1)
	for i in range(0,last_game_size.y+1):
		draw_line(Vector2(0,16*i), Vector2(16*last_game_size.x,16*i), line_color, 1)

func connected(data):
	Globals.my_client_id = data['client_id']

func game_state(data):
	if (data.get('game_over')):
		set_process_input(false)
	else:
		last_game_size = Vector2(data.width, data.height)
		queue_redraw()
		set_process_input(true)
		clear()
		for client_id in data.snakes.keys():
			var snake = data.snakes[client_id]
			for cell in snake.body:
				set_cell(
					0, Vector2i(cell.x, cell.y), 0, Vector2i(1, 1)
				)
			set_cell(
				0, Vector2i(data.food.position.x,data.food.position.y), 0, Vector2i(2,4)
			)
			if client_id == Globals.my_client_id:
				get_viewport().get_camera_2d().position = Vector2(
					snake.body[0].x*16,
					snake.body[0].y*16
				)

func _input(event):
	var dir = \"\";
	if event.is_action('ui_left'):
		dir = \"Left\"
	elif event.is_action('ui_right'):
		dir = \"Right\"
	elif event.is_action('ui_down'):
		dir = \"Down\"
	elif event.is_action('ui_up'):
		dir = \"Up\"
	if not dir.is_empty() and event.is_pressed():
		ClientController.send_packet({
			type = \"input\",
			direction = dir
		})
		get_viewport().set_input_as_handled()
"

